<div class="video-wrapper">
  <div class="container-video">
    <video src="../video.mp4" class="video"></video>

    <div class="controls">
      <div class="barre-orange">
        <div class="juice"></div>
      </div>

      <div class="buttons">
        <button id="play-pause">
          <img src="../play.svg" />
        </button>
        <button id="mute">Mute</button>
        <input
          type="range"
          id="volume-slider"
          min="0"
          max="100"
          value="50"
          step="1"
        />
        <button id="fullscreen">
          <img src="../fullscreen.svg" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const video = document.querySelector(".video") as HTMLVideoElement;
  const btnPausePlay = document.getElementById("play-pause");
  const img = document.querySelector("#play-pause img") as HTMLImageElement;
  const barreOrange = document.querySelector(".barre-orange") as HTMLElement;
  const juice = document.querySelector(".juice") as HTMLElement;
  const muteBtn = document.getElementById("mute") as HTMLButtonElement;
  const fullScreen = document.getElementById("fullscreen");
  const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement;

  btnPausePlay.addEventListener("click", togglePlayPause);
  video.addEventListener("click", togglePlayPause);

  function togglePlayPause() {
    if (video.paused) {
      img.src = "../pause.svg";
      video.play();
    } else {
      img.src = "../play.svg";
      video.pause();
    }
  }

  video.addEventListener("timeupdate", () => {
    const juicePos = video.currentTime / video.duration;
    juice.style.width = juicePos * 100 + "%";
    if (video.ended) img.src = "../play.svg";
  });

  volumeSlider.addEventListener("change", () => {
    video.volume = Number(volumeSlider.value) / 100;
  });

  muteBtn.addEventListener("click", () => {
    video.muted = !video.muted;
    muteBtn.innerText = video.muted ? "Unmute" : "Mute";
  });

  let rect = barreOrange.getBoundingClientRect();

  barreOrange.addEventListener("click", (e) => {
    const x = e.clientX - rect.left;
    const widthPercent = (x * 100) / rect.width;
    video.currentTime = video.duration * (widthPercent / 100);
  });

  window.addEventListener("resize", () => {
    rect = barreOrange.getBoundingClientRect();
  });

  video.addEventListener("dblclick", () => video.requestFullscreen());
  fullScreen.addEventListener("click", () => video.requestFullscreen());
</script>

<style>
  .video-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 50vh;
    background: rgb(34, 32, 32);
    border-radius: 0.5rem;
    padding: 2rem;
  }

  .container-video {
    width: min(800px, 100%);
    position: relative;
    overflow: hidden;
    border-radius: 0.25rem;
  }

  .video {
    width: 100%;
    display: block;
  }

  .controls {
    display: flex;
    position: absolute;
    bottom: 0;
    width: 100%;
    flex-wrap: wrap;
    background: rgba(0, 0, 0, 0.7);
    transform: translateY(90%);
    transition: transform 0.2s ease;
  }

  .container-video:hover .controls {
    transform: translateY(0);
  }

  .buttons {
    padding: 5px 10px 10px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .buttons button {
    background: none;
    border: 0;
    outline: 0;
    cursor: pointer;
    color: #fff;
  }

  #mute {
    position: relative;
    top: -5px;
    margin: 0 12px;
  }

  #play-pause img {
    width: 30px;
    position: relative;
    top: 5px;
  }

  .barre-orange {
    height: 10px;
    width: 100%;
    background: #000;
    cursor: pointer;
  }

  .juice {
    height: 10px;
    background-color: orangered;
  }

  #fullscreen {
    position: absolute;
    right: 15px;
    top: 25px;
  }

  #fullscreen img {
    width: 20px;
  }

  @media (max-width: 599px) {
    .video-wrapper {
      padding: 1rem;
    }
  }
</style>
